# Yapay Zekâ Satış Danışmanı – isteğe bağlı API anahtarları.
# Streamlit Cloud: App settings > Secrets alanına yapıştırın. Yerelde: bu dosyayı .streamlit/secrets.toml olarak kopyalayın.
# Anahtar tanımlıysa danışman sayfasında otomatik kullanılır (değeri ekranda gösterilmez).
# Anahtar yoksa kullanıcı kenar çubuğundan kendi anahtarını girebilir (yalnızca o oturumda kullanılır).

# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-6-luna"

# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-5-5"

# GEMINI_API_KEY = "..."
# GEMINI_MODEL = "gemini-3.5-flash"

# Ollama (yerel varsayılan: http://localhost:11434, model qwen2.5:7b)
# OLLAMA_HOST = "http://sunucu-adresi:11434"
# OLLAMA_MODEL = "qwen2.5:7b"
# OLLAMA_API_KEY = "..."   # Ollama Cloud için
